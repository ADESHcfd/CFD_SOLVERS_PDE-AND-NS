"""
FTCS Advection Solver with Zero-Neumann Boundary Conditions

Equation:
    ∂u/∂t + c ∂u/∂x = 0

Spatial Discretization:
    Central Difference

Temporal Discretization:
    Forward Euler (FTCS)

Boundary Conditions:
    Zero-Gradient Neumann BCs

Author: Adesh Kanthale
"""

import numpy as np
import matplotlib.pyplot as plt


# ============================================================
# Grid Definition
# ============================================================

nx = 100

xmin = 0.0
xmax = 1.0

dx = (xmax - xmin) / (nx - 1)

xcoords = np.linspace(xmin, xmax, nx)


# ============================================================
# Initial Condition
# ============================================================

u = np.zeros(nx)

# Hat Function
u[(xcoords >= 1/3) & (xcoords <= 2/3)] = 1.0

uinit = u.copy()


# ============================================================
# Time Integration Parameters
# ============================================================

c = 1.0               # Advection velocity
co = 0.01             # Courant number

dt = co * dx / c

tcurrent = 0.0
tmax = 1.0


# ============================================================
# Time Integration Loop
# ============================================================

while tcurrent < tmax:

    # Adjust final timestep
    if tcurrent + dt > tmax:
        dt = tmax - tcurrent
        co = c * dt / dx

    # Allocate new solution array
    unew = np.zeros(nx)

    # --------------------------------------------------------
    # FTCS Update (Interior Nodes)
    # --------------------------------------------------------

    for i in range(1, nx - 1):

        unew[i] = (
            u[i]
            - 0.5 * co * (u[i + 1] - u[i - 1])
        )

    # --------------------------------------------------------
    # Zero-Neumann Boundary Conditions
    # --------------------------------------------------------

    # Left Boundary: du/dx = 0
    unew[0] = unew[1]

    # Right Boundary: du/dx = 0
    unew[nx - 1] = unew[nx - 2]

    # --------------------------------------------------------
    # Update Solution
    # --------------------------------------------------------

    u[:] = unew[:]

    # Advance Time
    tcurrent += dt


# ============================================================
# Post-Processing
# ============================================================

print(f"Simulation completed at t = {tcurrent:.6f}")

plt.figure(figsize=(8, 5))

plt.plot(
    xcoords,
    uinit,
    label="Initial Condition",
    linewidth=2
)

plt.plot(
    xcoords,
    u,
    label="Final Solution",
    linewidth=2
)

plt.xlabel("x")
plt.ylabel("u")
plt.title("FTCS Advection with Zero-Neumann Boundary Conditions")

plt.legend()
plt.grid(True)

plt.tight_layout()
plt.show()
